# Copy to .env and fill in. NEVER commit .env.

# ---- Database -------------------------------------------------------------
# Note the +asyncpg driver — SQLAlchemy needs it for async.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sheaf

# ---- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ---- CORS -----------------------------------------------------------------
# Where the React app runs. Comma-separated. No trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Cookies --------------------------------------------------------------
# Set true in production (HTTPS only). Must be false for local http://.
COOKIE_SECURE=false
# "lax" for same-site dev; "none" when frontend and API are on different domains
# (and then COOKIE_SECURE must be true).
COOKIE_SAMESITE=lax

ENVIRONMENT=development
